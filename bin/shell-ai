#!/usr/bin/env bash
# ==============================================================================
# shell-ai: Universal Terminal AI Dispatcher
# ==============================================================================
set -e

# Version
SHELL_AI_VERSION="2.1.0"

# Find root directory
SCRIPT_PATH="${BASH_SOURCE[0]:-$0}"
while [ -h "$SCRIPT_PATH" ]; do
    DIR="$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)"
    SCRIPT_PATH="$(readlink "$SCRIPT_PATH")"
    [[ $SCRIPT_PATH != /* ]] && SCRIPT_PATH="$DIR/$SCRIPT_PATH"
done
SHELL_AI_ROOT="$(cd -P "$(dirname "$SCRIPT_PATH")/.." && pwd)"

# Load user config if present
USER_CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/shell-ai"
if [ -f "$USER_CONFIG_DIR/config" ]; then
    # shellcheck source=/dev/null
    source "$USER_CONFIG_DIR/config"
fi

# Context memory storage — configurable via SHELL_AI_HISTORY_MODE
# Options: "persistent" (default, survives reboots) | "tmp" (cleared on reboot)
: "${SHELL_AI_HISTORY_MODE:=persistent}"
if [ "$SHELL_AI_HISTORY_MODE" = "persistent" ]; then
    _SHELL_AI_STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/shell-ai"
    mkdir -p "$_SHELL_AI_STATE_DIR" 2>/dev/null || _SHELL_AI_STATE_DIR="${TMPDIR:-/tmp}"
    HISTORY_FILE="${_SHELL_AI_STATE_DIR}/history.txt"
else
    HISTORY_FILE="${TMPDIR:-/tmp}/shell-ai-history.txt"
fi

# Load backend adapters
for b in "$SHELL_AI_ROOT"/backends/*.sh; do
    if [ -f "$b" ]; then
        # shellcheck source=/dev/null
        source "$b"
    fi
done

# ANSI color codes
if [ -t 1 ] && [ "${SHELL_AI_NO_COLOR:-0}" != "1" ]; then
    C_GREEN='\033[0;32m'
    C_YELLOW='\033[0;33m'
    C_BOLD='\033[1m'
    C_DIM='\033[2m'
    C_RESET='\033[0m'
else
    C_GREEN=''
    C_YELLOW=''
    C_BOLD=''
    C_DIM=''
    C_RESET=''
fi

# Helper: Run command with a visual spinner until the first byte of output is received on stdin
run_with_spinner() {
    # Skip spinner if not attached to a TTY or raw mode requested
    if [ ! -t 2 ] || [ "${SHELL_AI_RAW:-0}" = "1" ]; then
        "$@"
        return
    fi

    local char
    local spinner=( "⠋" "⠙" "⠹" "⠸" "⠼" "⠴" "⠦" "⠧" "⠇" "⠏" )
    local i=0

    # Use a tmp file to smuggle the backend exit code out of the subshell
    local status_file
    status_file=$(mktemp)

    tput civis >&2 2>/dev/null || true

    # Run backend in background, capture its exit code
    {
        "$@"
        echo $? > "$status_file"
    } | while true; do
        local ret=0
        IFS= read -r -t 0.1 -d "" -N1 char || ret=$?

        if [ -n "$char" ]; then
            # We got our first byte!
            tput cnorm >&2 2>/dev/null || true
            printf "\r\033[K" >&2

            # Print the first byte and cat the rest of the stream unbuffered
            printf "%s" "$char"
            cat
            return
        elif [ $ret -le 128 ]; then
            # EOF reached without any data
            tput cnorm >&2 2>/dev/null || true
            printf "\r\033[K" >&2
            return
        fi

        # Tick the spinner
        printf "\r\033[1;36m%s\033[0m \033[2mthinking...\033[0m" "${spinner[$i]}" >&2
        i=$(( (i + 1) % 10 ))
    done

    # Propagate the backend's exit code
    local backend_status=0
    [ -f "$status_file" ] && backend_status=$(cat "$status_file")
    rm -f "$status_file"
    return "$backend_status"
}


# Helper: Built-in Zero-Dependency ANSI Markdown Renderer (using standard POSIX awk)
builtin_render_markdown() {
    awk '
    BEGIN {
        BOLD="\033[1m"; RESET="\033[0m"; DIM="\033[2m"
        BLUE="\033[1;34m"; CYAN="\033[1;36m"; YELLOW="\033[1;33m"; GREEN="\033[32m"
        in_code=0
    }
    {
        line = $0
        # Strip stray ANSI cursor-movement / control sequences (e.g. \033[D, \033[C, \033[K, \033[nA)
        # that some backends leak into their output. Preserve color codes (\033[...m).
        gsub(/\033\[[0-9]*[A-LN-Z]/, "", line)
        gsub(/\033\[[0-9;]*[a-ln-z]/, "", line)
        # Code block toggle (supports indented code blocks)
        if (line ~ /^[[:space:]]*```/) {
            if (in_code == 0) {
                in_code = 1
                match(line, /```[a-zA-Z0-9_-]*/)
                lang = substr(line, RSTART + 3, RLENGTH - 3)
                if (lang != "") print DIM "  ╭─ " lang RESET
                else print DIM "  ╭────────────────────────────────────" RESET
            } else {
                in_code = 0
                print DIM "  ╰────────────────────────────────────" RESET
            }
            next
        }
        if (in_code) {
            sub(/^[[:space:]]{0,4}/, "", line)
            print "  │ " GREEN line RESET
            next
        }
        # Headers
        if (line ~ /^# /) {
            sub(/^# /, "", line)
            print "\n" BLUE BOLD "■ " toupper(line) RESET
            next
        }
        if (line ~ /^## /) {
            sub(/^## /, "", line)
            print "\n" CYAN BOLD "▸ " line RESET
            next
        }
        if (line ~ /^### /) {
            sub(/^### /, "", line)
            print "\n" YELLOW BOLD "▪ " line RESET
            next
        }
        # Horizontal rule
        if (line ~ /^---+$/) {
            print DIM "  ────────────────────────────────────────" RESET
            next
        }
        # Blockquotes
        if (line ~ /^[[:space:]]*>[[:space:]]?/) {
            sub(/^[[:space:]]*>[[:space:]]?/, "", line)
            print DIM "  │ " RESET line
            next
        }
        # Bullets
        if (line ~ /^[[:space:]]*[\*\-][[:space:]]/) {
            sub(/^[[:space:]]*[\*\-][[:space:]]/, "  • ", line)
        }
        # Inline code
        while (match(line, /`[^`]+`/)) {
            code = substr(line, RSTART + 1, RLENGTH - 2)
            line = substr(line, 1, RSTART - 1) CYAN code RESET substr(line, RSTART + RLENGTH)
        }
        # Bold **text**
        while (match(line, /\*\*[^\*]+\*\*/)) {
            txt = substr(line, RSTART + 2, RLENGTH - 4)
            line = substr(line, 1, RSTART - 1) BOLD txt RESET substr(line, RSTART + RLENGTH)
        }
        print line; fflush()
    }'
}

# Helper: Route markdown rendering
render_markdown() {
    if [ ! -t 1 ] || [ "${SHELL_AI_RAW:-0}" = "1" ] || [ "${SHELL_AI_RENDERER}" = "none" ]; then
        cat
        return
    fi

    # Explicit override
    if [ "${SHELL_AI_RENDERER}" = "builtin" ]; then
        builtin_render_markdown
        return
    elif [ "${SHELL_AI_RENDERER}" = "glow" ] && command -v glow >/dev/null 2>&1; then
        glow -
        return
    elif [ "${SHELL_AI_RENDERER}" = "bat" ] && command -v bat >/dev/null 2>&1; then
        bat -l markdown --style=plain --paging=never --color=always
        return
    fi

    # Auto mode: Use builtin by default because glow blocks real-time streaming
    builtin_render_markdown
}

# Helper: Detect best default backend if not explicitly set
get_default_backend() {
    if [ -n "$SHELL_AI_DEFAULT_BACKEND" ]; then
        echo "$SHELL_AI_DEFAULT_BACKEND"
        return
    fi

    if backend_agy_is_available; then
        echo "agy"
    elif backend_claude_is_available; then
        echo "claude"
    elif backend_ollama_is_available; then
        echo "ollama"
    elif backend_copilot_is_available; then
        echo "copilot"
    elif backend_custom_is_available; then
        echo "custom"
    else
        echo "agy" # fallback
    fi
}

show_help() {
    cat <<EOF
${C_BOLD}shell-ai${C_RESET} v${SHELL_AI_VERSION} - Universal AI integration for your terminal

${C_BOLD}USAGE:${C_RESET}
    shell-ai [options] <action> [arguments...]
    shell-ai "your question here"

${C_BOLD}ACTIONS:${C_RESET}
    ${C_GREEN}ask${C_RESET} <query>               Ask a question and get an explanation
    ${C_GREEN}cmd${C_RESET} <query>               Generate a raw shell command (no markdown)
    ${C_GREEN}fix${C_RESET} [exit_code] [cmd]     Diagnose a failed command and suggest a fix
    ${C_GREEN}interactive${C_RESET} [backend]     Launch the full interactive agent session
    ${C_GREEN}history${C_RESET} [show|clear|path] View, clear, or locate conversation memory
    ${C_GREEN}clear${C_RESET}                     Clear conversation memory (alias for history clear)
    ${C_GREEN}list-backends${C_RESET}           Show available backends and system status

${C_BOLD}OPTIONS:${C_RESET}
    ${C_YELLOW}-b, --backend <name>${C_RESET}     Override backend (agy, claude, ollama, copilot, custom)
    ${C_YELLOW}-nc, --no-context${C_RESET}       Do not use or save conversation history (memory)
    ${C_YELLOW}-h, --help${C_RESET}               Show this help message
    ${C_YELLOW}-v, --version${C_RESET}            Show version information

${C_BOLD}SUPPORTED BACKENDS:${C_RESET}
    • agy       (Google Antigravity CLI)
    • claude    (Anthropic Claude Code CLI)
    • ollama    (Local LLMs e.g. Qwen, Llama 3)
    • copilot   (GitHub CLI extension)
    • custom    (User configured script or curl call)

${C_BOLD}CONFIG FILE:${C_RESET}
    ${USER_CONFIG_DIR}/config
EOF
}

# Parse options
: "${BACKEND_OVERRIDE:=}"

while [[ $# -gt 0 ]]; do
    case "$1" in
        -b|--backend)
            BACKEND_OVERRIDE="$2"
            shift 2
            ;;
        -nc|--no-context)
            NO_CONTEXT_OVERRIDE="1"
            shift 1
            ;;
        -h|--help)
            show_help
            # shellcheck disable=SC2317
            return 0 2>/dev/null || exit 0
            ;;
        -v|--version)
            echo "shell-ai version $SHELL_AI_VERSION"
            # shellcheck disable=SC2317
            return 0 2>/dev/null || exit 0
            ;;
        *)
            break
            ;;
    esac
done

ACTIVE_BACKEND="${BACKEND_OVERRIDE:-$(get_default_backend)}"

# Validate backend name
case "$ACTIVE_BACKEND" in
    agy|claude|ollama|copilot|custom) ;;
    *)
        echo -e "${C_YELLOW}Warning:${C_RESET} Unknown backend '${ACTIVE_BACKEND}'. Valid options: agy, claude, ollama, copilot, custom." >&2
        echo "Falling back to auto-detection..." >&2
        ACTIVE_BACKEND="$(SHELL_AI_DEFAULT_BACKEND='' get_default_backend)"
        ;;
esac

# Helper: Handle memory context for ask queries
handle_ask_with_memory() {
    local fn="$1"
    local raw_prompt="$2"
    local history_prompt="$raw_prompt"

    if [ "${SHELL_AI_NO_CONTEXT:-0}" != "1" ] && [ "${NO_CONTEXT_OVERRIDE:-0}" != "1" ]; then
        if [ -f "$HISTORY_FILE" ]; then
            history_prompt="$(cat "$HISTORY_FILE")

Current Query: $raw_prompt"
        fi
    fi

    local tmp_out
    tmp_out=$(mktemp)
    # Ensure temp file is cleaned up on interrupt or early exit
    trap 'rm -f "$tmp_out"' EXIT INT TERM

    # Fetch output via spinner and stream it
    if command -v python3 >/dev/null 2>&1 && [ -f "$SHELL_AI_ROOT/bin/smooth_render.py" ]; then
        run_with_spinner "$fn" "$history_prompt" | stdbuf -o0 tee "$tmp_out" | python3 "$SHELL_AI_ROOT/bin/smooth_render.py"
        echo ""
    elif command -v stdbuf >/dev/null 2>&1; then
        # Note: fold removed — it is byte-unaware and breaks mid-ANSI-escape-code.
        # Let the terminal handle line wrapping natively.
        run_with_spinner "$fn" "$history_prompt" | stdbuf -o0 tee "$tmp_out" | render_markdown
    else
        run_with_spinner "$fn" "$history_prompt" | while IFS= read -r line || [ -n "$line" ]; do
            printf "%s\n" "$line" >> "$tmp_out"
            printf "%s\n" "$line"
        done | render_markdown
    fi

    if [ "${SHELL_AI_NO_CONTEXT:-0}" != "1" ] && [ "${NO_CONTEXT_OVERRIDE:-0}" != "1" ]; then
        # Save to history
        {
            echo "Previous Query: $raw_prompt"
            echo "Previous Answer:"
            cat "$tmp_out"
            echo "---"
        } >> "$HISTORY_FILE"

        # Keep only the last 3 pairs
        awk 'BEGIN {RS="---\n"} {if (length($0) > 0) a[NR]=$0} END {for(i=NR-2; i<=NR; i++) if(i in a) printf "%s---\n", a[i]}' "$HISTORY_FILE" > "${HISTORY_FILE}.tmp" && mv "${HISTORY_FILE}.tmp" "$HISTORY_FILE"
    fi

    rm -f "$tmp_out"
    trap - EXIT INT TERM
}

# Route actions
ACTION="$1"

case "$ACTION" in
    clear)
        if [ $# -gt 1 ]; then
            PROMPT="$*"
            fn="backend_${ACTIVE_BACKEND}_ask"
            if type "$fn" >/dev/null 2>&1; then
                handle_ask_with_memory "$fn" "$PROMPT"
            else
                echo "Error: Unknown backend '$ACTIVE_BACKEND'" >&2
                exit 1
            fi
        else
            rm -f "$HISTORY_FILE"
            echo -e "${C_GREEN}✔${C_RESET} shell-ai conversation memory cleared."
            # shellcheck disable=SC2317
            return 0 2>/dev/null || exit 0
        fi
        ;;

    history)
        if [ $# -gt 1 ] && [ "$2" != "show" ] && [ "$2" != "clear" ] && [ "$2" != "path" ]; then
            PROMPT="$*"
            fn="backend_${ACTIVE_BACKEND}_ask"
            if type "$fn" >/dev/null 2>&1; then
                handle_ask_with_memory "$fn" "$PROMPT"
            else
                echo "Error: Unknown backend '$ACTIVE_BACKEND'" >&2
                exit 1
            fi
        else
            shift
            case "${1:-show}" in
                show)
                    if [ -f "$HISTORY_FILE" ] && [ -s "$HISTORY_FILE" ]; then
                        echo -e "${C_BOLD}Conversation Memory:${C_RESET} ($HISTORY_FILE)"
                        echo ""
                        render_markdown < "$HISTORY_FILE"
                    else
                        echo -e "${C_DIM}No conversation history yet.${C_RESET}"
                    fi
                    ;;
                clear)
                    rm -f "$HISTORY_FILE"
                    echo -e "${C_GREEN}✔${C_RESET} shell-ai conversation memory cleared."
                    ;;
                path)
                    echo "$HISTORY_FILE"
                    ;;
                *)
                    echo "Usage: shell-ai history [show|clear|path]" >&2
                    exit 1
                    ;;
            esac
            # shellcheck disable=SC2317
            return 0 2>/dev/null || exit 0
        fi
        ;;

    list-backends)
        if [ $# -gt 1 ]; then
            PROMPT="$*"
            fn="backend_${ACTIVE_BACKEND}_ask"
            if type "$fn" >/dev/null 2>&1; then
                handle_ask_with_memory "$fn" "$PROMPT"
            else
                echo "Error: Unknown backend '$ACTIVE_BACKEND'" >&2
                exit 1
            fi
        else
            echo -e "${C_BOLD}Available Backends:${C_RESET}"
            default_b=$(get_default_backend)
            for b in agy claude ollama copilot custom; do
                is_avail="no"
                if "backend_${b}_is_available" 2>/dev/null; then
                    is_avail="${C_GREEN}installed${C_RESET}"
                else
                    is_avail="${C_DIM}not found${C_RESET}"
                fi
                
                is_def=""
                if [ "$b" = "$default_b" ]; then
                    is_def="${C_YELLOW}(default)${C_RESET}"
                fi
                printf "  %-10s : %-20b %b\n" "$b" "$is_avail" "$is_def"
            done
        fi
        ;;

    interactive)
        target_b="${2:-$ACTIVE_BACKEND}"
        if [ $# -gt 2 ] || { [ $# -eq 2 ] && ! type "backend_${target_b}_interactive" >/dev/null 2>&1; }; then
            # Looks like a natural query
            PROMPT="$*"
            fn="backend_${ACTIVE_BACKEND}_ask"
            if type "$fn" >/dev/null 2>&1; then
                handle_ask_with_memory "$fn" "$PROMPT"
            else
                echo "Error: Unknown backend '$ACTIVE_BACKEND'" >&2
                exit 1
            fi
        else
            shift
            if type "backend_${target_b}_interactive" >/dev/null 2>&1; then
                "backend_${target_b}_interactive"
            else
                echo "Error: Unknown backend '$target_b'" >&2
                exit 1
            fi
        fi
        ;;

    cmd)
        shift
        PROMPT="$*"
        if [ -z "$PROMPT" ]; then
            echo "Error: prompt required for 'cmd'" >&2
            exit 1
        fi
        fn="backend_${ACTIVE_BACKEND}_cmd"
        if type "$fn" >/dev/null 2>&1; then
            if [ ! -t 1 ] || [ "${SHELL_AI_RAW:-0}" = "1" ]; then
                # Raw output for Zsh/Bash plugin buffer injection
                "$fn" "$PROMPT"
            else
                # Interactive CLI mode
                RAW_CMD=$(run_with_spinner "$fn" "$PROMPT")
                echo -e "\nProposed Command:\n${C_GREEN}${C_BOLD}${RAW_CMD}${C_RESET}\n"
                
                # Save and restore TTY state so read works inside ZLE raw mode
                old_stty=$(stty -g 2>/dev/null || true)
                stty sane 2>/dev/null || true
                
                if [ -r /dev/tty ]; then
                    read -r -n 1 -p "Action: [e]xecute, [c]opy, [a]bort: " action </dev/tty
                    echo ""
                else
                    action="a"
                fi
                
                case "$action" in
                    [eE]*) 
                        eval "$RAW_CMD"
                        stty "$old_stty" 2>/dev/null || true
                        ;;
                    [cC]*) 
                        stty "$old_stty" 2>/dev/null || true
                        if command -v pbcopy >/dev/null 2>&1; then echo "$RAW_CMD" | pbcopy
                        elif command -v xclip >/dev/null 2>&1; then echo "$RAW_CMD" | xclip -sel clip
                        elif command -v wl-copy >/dev/null 2>&1; then echo "$RAW_CMD" | wl-copy
                        else echo "No clipboard tool found (pbcopy/xclip/wl-copy)."; fi
                        ;;
                    *) 
                        stty "$old_stty" 2>/dev/null || true
                        echo "Aborted." 
                        ;;
                esac
            fi
        else
            echo "Error: Backend '$ACTIVE_BACKEND' does not support command generation." >&2
            exit 1
        fi
        ;;

    fix)
        if [ $# -ge 2 ] && [[ "$2" =~ ^[0-9]+$ ]]; then
            shift
            EXIT_CODE="${1:-1}"
            LAST_CMD="$2"
            CONTEXT="$3"
            fn="backend_${ACTIVE_BACKEND}_fix"
            if type "$fn" >/dev/null 2>&1; then
                run_with_spinner "$fn" "$LAST_CMD" "$EXIT_CODE" "$CONTEXT" | render_markdown
            else
                echo "Error: Backend '$ACTIVE_BACKEND' does not support fix." >&2
                exit 1
            fi
        else
            PROMPT="$*"
            fn="backend_${ACTIVE_BACKEND}_ask"
            if type "$fn" >/dev/null 2>&1; then
                handle_ask_with_memory "$fn" "$PROMPT"
            else
                echo "Error: Unknown backend '$ACTIVE_BACKEND'" >&2
                exit 1
            fi
        fi
        ;;

    ask)
        shift
        PROMPT="$*"
        if [ -z "$PROMPT" ]; then
            echo "Error: prompt required for 'ask'" >&2
            exit 1
        fi
        fn="backend_${ACTIVE_BACKEND}_ask"
        if type "$fn" >/dev/null 2>&1; then
            handle_ask_with_memory "$fn" "$PROMPT"
        else
            echo "Error: Unknown backend '$ACTIVE_BACKEND'" >&2
            exit 1
        fi
        ;;

    "")
        show_help
        # shellcheck disable=SC2317
            return 0 2>/dev/null || exit 0
        ;;

    *)
        # Default fallback: treat entire argument string as an 'ask' query
        PROMPT="$*"
        fn="backend_${ACTIVE_BACKEND}_ask"
        if type "$fn" >/dev/null 2>&1; then
            handle_ask_with_memory "$fn" "$PROMPT"
        else
            echo "Error: Unknown backend '$ACTIVE_BACKEND'" >&2
            exit 1
        fi
        ;;
esac
